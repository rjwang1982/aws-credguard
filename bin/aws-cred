#!/bin/bash
# credential_process：Touch ID 解密 AKSK → STS 临时凭证（缓存 1 小时）
# config: credential_process = $HOME/.aws/bin/aws-cred <profile>[-src]
set -euo pipefail
p="${1%-src}"
V="$HOME/.aws/vault"; C="$V/cache"; mkdir -p "$C"; chmod 700 "$C"
unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
hdr="[profile $p]"; [ "$p" = "default" ] && hdr="[default]"
r=$(/usr/bin/awk -v h="$hdr" '$0==h{f=1;next} /^\[/{f=0} f&&/^region/{sub(/^region *= */,"");print;exit}' "$HOME/.aws/config")
r="${r:-us-east-1}"
cf="$C/$p.json"
valid() { [ -s "$cf" ] && /usr/bin/python3 -c 'import json,sys,datetime as d;e=json.load(open(sys.argv[1]))["Expiration"];sys.exit(0 if d.datetime.fromisoformat(e.replace("Z","+00:00"))>d.datetime.now(d.timezone.utc)+d.timedelta(minutes=5) else 1)' "$cf" 2>/dev/null; }
valid && { cat "$cf"; exit 0; }
L="$C/$p.lock"; n=0
until mkdir "$L" 2>/dev/null; do
  sleep 0.5; n=$((n+1))
  [ $n -gt 240 ] && { rmdir "$L" 2>/dev/null || true; }
done
trap 'rmdir "$L" 2>/dev/null || true' EXIT
valid && { cat "$cf"; exit 0; }
pt=$($HOME/.aws/bin/aws-se decrypt "$p") || { echo "aws-cred: Touch ID 解密失败 ($p)" >&2; exit 1; }
AK="${pt%% *}"; SK="${pt#* }"; unset pt
[ -n "$AK" ] && [ -n "$SK" ] || { echo "aws-cred: 解密内容异常 ($p)" >&2; exit 1; }
AWS=$(command -v aws || echo /opt/homebrew/bin/aws)
if out=$(AWS_ACCESS_KEY_ID="$AK" AWS_SECRET_ACCESS_KEY="$SK" AWS_REGION="$r" AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null \
      "$AWS" sts get-session-token --duration-seconds 3600 --output json 2>/dev/null); then
  unset AK SK
  tmp=$(mktemp "$C/.$p.XXXX")
  printf '%s' "$out" | /usr/bin/python3 -c 'import json,sys;c=json.load(sys.stdin)["Credentials"];print(json.dumps({"Version":1,"AccessKeyId":c["AccessKeyId"],"SecretAccessKey":c["SecretAccessKey"],"SessionToken":c["SessionToken"],"Expiration":c["Expiration"]}))' > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$cf"; cat "$cf"
else
  # 失败即关闭：绝不输出长期密钥（root 密钥或无 sts:GetSessionToken 权限时会走到这里）
  unset AK SK
  echo "aws-cred: STS GetSessionToken 失败 ($p, region=$r)。不支持 root 密钥；请检查密钥是否有效。" >&2
  exit 1
fi
